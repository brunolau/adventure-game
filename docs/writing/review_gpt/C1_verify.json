  "keys": {
    "action.G02.004": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Tak to máš tretíkrát. A do obeda ti to zopakuje ešte aj Dana.",
      "batch": "G02"
    },
    "action.G02.x01": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Máme. Volala o siedmej, či je hotová, a o ôsmej, či si už vstal.",
      "batch": "G02"
    },
    "action.G02.x02": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "A čo si jej povedala?",
      "batch": "G02"
    },
    "action.G02.x03": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Že to v zozname nemám. Tak som si to tam dopísala.",
      "batch": "G02"
    },
    "action.G02.x04": {
      "verdict": "fix",
      "category": "nonsense",
      "problem": "The exchange counts reminders, with Ela delivering the third, but this line switches to counting Grandma's calls. Keep the fourth occurrence tied to the reminder.",
      "suggestion": "Ak mi to babka chce pripomenúť aj štvrtýkrát, povedz jej, že už idem.",
      "text": "Ak sa babka ozve aj štvrtýkrát, povedz jej, že už idem.",
      "batch": "G02"
    },
    "action.G02.x05": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Poviem. Mám ju v zozname hneď za zemiakmi.",
      "batch": "G02"
    },
    "action.G07.001": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "ZVON a nálepka „Sokolíkova 1995“. Ten prístroj poznám zo školy. Vtedy sme naň nesmeli ani dýchnuť.",
      "batch": "G07"
    },
    "action.G07.003": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Ja poznám jeho a on pozná mňa. Babka, toto si mi mala povedať, aj keď som sa nepýtal.",
      "batch": "G07"
    },
    "action.C01.002": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Potrebujem bezpečný návratový mostík. Vieš o nejakom?",
      "batch": "C01"
    },
    "action.C01.x01": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Babka, som späť. Aspoň v správnom roku. Musím ti niečo ukázať.",
      "batch": "C01"
    },
    "action.C01.x02": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Prilož to k sklu. Okuliare mám na nose od rána pre prípad, že sa vrátiš.",
      "batch": "C01"
    },
    "action.C01.x03": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Aj tie topánky. V Ivanke sa o nich hovorilo až do Vianoc.",
      "batch": "C01"
    },
    "action.C01.x04": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Ty si si ma celé tie roky pamätala?",
      "batch": "C01"
    },
    "action.C01.x05": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Topánky áno. Tvár som si k nim priradila až teraz.",
      "batch": "C01"
    },
    "action.C01.x06": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Technický majetok. Znie to, akoby som išiel po traktor.",
      "batch": "C01"
    },
    "action.C01.x07": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Pre školu je to majetok. Pre mňa krabica vecí, ktoré okrem mňa nikto nevie zapojiť.",
      "batch": "C01"
    },
    "action.C01.x08": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Ešte niečo, kým ma ten prístroj zase niekam pošle?",
      "batch": "C01"
    },
    "action.C01.x09": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Áno. Odfoť si školský dvor, presne taký, aký je dnes.",
      "batch": "C01"
    },
    "action.D03.x01": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Dobrý deň. Vidím vás, len trochu zhora. Tú knihu máte správnu.",
      "batch": "D03"
    },
    "action.D03.x02": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Oto si zapisoval naozaj všetko. Taký zoznam by sa mi zišiel aj v garáži.",
      "batch": "D03"
    },
    "action.D03.x03": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Nie zoznam. Záznam. Zoznam sa píše pred prácou, záznam po nej.",
      "batch": "D03"
    },
    "action.D03.x04": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Kópia je vaša, originál zostáva v kabinete. Tak to máme s Tónom dohodnuté.",
      "batch": "D03"
    },
    "action.D07.x01": {
      "verdict": "fix",
      "category": "tyvy",
      "problem": "Tóno addresses Adam informally in D07; this formal imperative conflicts with that switch.",
      "suggestion": "Povedz to ešte raz.",
      "text": "Povedzte to ešte raz.",
      "batch": "D07"
    },
    "action.D07.x02": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Lastovička sa vracia.",
      "batch": "D07"
    },
    "action.D07.x03": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Tvoja mapa sedela na kameň presne.",
      "batch": "D07"
    },
    "action.D07.x04": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Dedo ma naučil kresliť tak, aby tomu rozumel aj ten, kto pri tom nebol.",
      "batch": "D07"
    },
    "action.D07.x05": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Poviem mu. Slovo od slova.",
      "batch": "D07"
    },
    "action.C02.x01": {
      "verdict": "ok",
      "category": "",
      "problem": "",
      "suggestion": "",
      "text": "Babka mi volala, že ho máš. Asi skôr, ako si ho našla.",
